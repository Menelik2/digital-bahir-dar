# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-jwt-key

# Map
# Without a token → Leaflet + free OpenStreetMap tiles.
# With a public Mapbox token → Mapbox GL JS (vector maps, smoother mobile):
#   1. Create token at https://account.mapbox.com/access-tokens/
#   2. Restrict by URL (your domain)
#   3. Set in Vercel / local .env:
VITE_MAPBOX_ACCESS_TOKEN=pk.your_mapbox_public_token

# Edge Function secrets only via: supabase secrets set
