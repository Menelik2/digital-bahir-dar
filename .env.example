# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-jwt-key

# Map — Mapbox GL (optional)
# Without token → Leaflet + OSM. With token → Mapbox GL JS.
VITE_MAPBOX_ACCESS_TOKEN=pk.your_mapbox_public_token

# Google Maps Embed (optional)
# Without key → free iframe embed (q= / saddr-daddr).
# With key → official Embed API (enable Maps Embed API in Google Cloud):
# VITE_GOOGLE_MAPS_EMBED_KEY=AIza...

# Edge Function secrets only via: supabase secrets set

# Google Places API (New) — optional Place Photos for hotels / POIs
# Enable "Places API (New)" in Google Cloud + billing. Without this key,
# the app uses curated Wikimedia covers (no scraping of Google Maps).
# VITE_GOOGLE_PLACES_API_KEY=AIza...
