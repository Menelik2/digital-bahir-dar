# Frontend-safe (Vercel / .env.local)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Enable Maps JavaScript API + Places API (optional) in Google Cloud Console
# Restrict the key by HTTP referrer in production

# Edge Function secrets only (never in frontend) — set via:
#   supabase secrets set AI_API_KEY=sk-...
#   supabase secrets set AI_MODEL=gpt-4o-mini
# SUPABASE_SERVICE_ROLE_KEY=
# AI_API_KEY=
# AI_MODEL=gpt-4o-mini
# PRIVATE_GOOGLE_API_KEY=
# WEATHER_API_KEY=
