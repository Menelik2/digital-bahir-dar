# Frontend-safe only (Vercel / .env.local) — never commit real secrets beyond anon key
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-jwt-key

# Mapbox (Bahir Dar city map only)
# Create a token at https://account.mapbox.com/access-tokens/
# Use a public/default token with URL restrictions for your domain (e.g. *.vercel.app)
VITE_MAPBOX_ACCESS_TOKEN=pk.your_mapbox_public_token

# Optional legacy — not required (app uses Mapbox or OSM)
# VITE_GOOGLE_MAPS_API_KEY=
# VITE_GOOGLE_MAPS_MAP_ID=

# Edge Function secrets only via: supabase secrets set
# AI_API_KEY=
# AI_MODEL=llama-3.3-70b-versatile
