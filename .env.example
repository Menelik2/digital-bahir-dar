# Frontend-safe only (Vercel / .env.local) — never commit real secrets beyond anon key
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-jwt-key

# Map uses free OpenStreetMap (Leaflet) — no Google key required.
# Optional: leave blank. Directions still open Google Maps in the browser.
# VITE_GOOGLE_MAPS_API_KEY=
# VITE_GOOGLE_MAPS_MAP_ID=

# Edge Function secrets only via: supabase secrets set
# AI_API_KEY=
# AI_MODEL=llama-3.3-70b-versatile
